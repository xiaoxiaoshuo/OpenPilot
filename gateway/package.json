{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenPilot Chat gateway — 原生 node:http 轻量 HTTP 服务，零运行时依赖",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --experimental-strip-types --watch src/server.ts",
    "start": "node --env-file-if-exists=../.env --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "jose": "^6.2.8",
    "lru-cache": "^11.5.2"
  }
}
