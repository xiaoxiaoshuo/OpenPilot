# ============================================================
# OpenPilot Chat — 环境变量示例
# 使用：cp .env.example .env  然后填写真实值
# 说明：gateway / IdP / core 三个服务共用根目录 .env
# ============================================================

# ── GitHub OAuth（可选，用于 GitHub 登录）──
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Google OAuth（可选；国内服务器无代理时不可用）──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── 公网地址（本地开发默认 127.0.0.1:8200；生产改为你的域名）──
IDP_ISSUER=http://127.0.0.1:8200/idp
IDP_REDIRECT_URI=http://127.0.0.1:8200/auth/callback
GITHUB_CALLBACK_URI=http://127.0.0.1:8200/idp/callback/github
GOOGLE_CALLBACK_URI=http://127.0.0.1:8200/idp/callback/google
GATEWAY_PUBLIC_URL=http://127.0.0.1:8200

# ── 内部上游（固定 127.0.0.1）──
IDP_UPSTREAM=http://127.0.0.1:8201
WEB_UI_UPSTREAM=http://127.0.0.1:8202

# ── OIDC 客户端（IdP 的 client 即 gateway）──
OIDC_CLIENT_ID=openpilot-web
IDP_CLIENT_ID=openpilot-web
# 以下两个密钥至少 32 位，请替换为随机值
IDP_CLIENT_SECRET=change-me-idp-client-secret-min-32-chars
IDP_TOKEN_SECRET=change-me-idp-token-secret-min-32-chars
# 留空则分别回退到 IDP_CLIENT_SECRET / IDP_TOKEN_SECRET
OIDC_CLIENT_SECRET=
GATEWAY_SESSION_SECRET=
GATEWAY_SESSION_TTL_S=604800

# ── portal 身份签名密钥（gateway / web-ui / core 三者必须完全一致）──
PORTAL_IDENTITY_SECRET=change-me-portal-identity-secret

# ── core ──
CORE_ORG_ID=local
CORE_DATA_DIR=data

# ── DeepSeek 大模型 ──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
CORE_MODEL=deepseek-chat
CORE_MODELS=deepseek-chat,deepseek-reasoner

# ── 演示登录（本地开发 / 评审用；NODE_ENV=production 时会自动禁用）──
IDP_DEMO_LOGIN_ENABLED=true

# ── 出站代理（可选：本地开发访问 Google/GitHub 时使用，服务器一般不需要）──
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# all_proxy=socks5://127.0.0.1:7897
